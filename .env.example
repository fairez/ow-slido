# Every variable the app reads. "Production" says whether a public deployment needs it.
# Real values go in .env.local (gitignored) or the host's variables, never in this file.

# --- Core ---------------------------------------------------------------------------------
# Production: required. Postgres URL of the dev/production database.
DATABASE_URL=
# Local only: Postgres URL of the test database (unit and e2e tests). Never set in production.
TEST_DATABASE_URL=
# Production: required. Signs host login sessions. Long random string (`openssl rand -hex 32`); changing it logs everyone out.
SESSION_SECRET=
# Production: required. Signs participant tokens. Another long random string, not the same as SESSION_SECRET; changing it makes participants rejoin.
PARTICIPANT_TOKEN_SECRET=
# Production: strongly recommended. Set to false once the first admin exists, so strangers cannot sign up.
ALLOW_SIGNUP=
# Local only: hosts allowed to load `next dev` assets besides localhost (comma separated).
ALLOWED_DEV_ORIGINS=

# --- AI analysis for Shared Notes ---------------------------------------------------------
# Production: only for AI. `openai` or `openrouter`; empty hides every AI control. `mock` is for tests and development, never production.
AI_PROVIDER=
# Production: only for AI. The key of the chosen provider (platform owner's key; .env.local or host variables only).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional. Model name; empty uses the provider default.
AI_MODEL=
# Optional. AI calls per event (default 20) and in total per UTC day (default 200); beyond them analysis falls back to keywords.
AI_EVENT_CALL_CAP=
AI_DAILY_CALL_CAP=
# Optional but set it to your budget. Hard stop for AI calls per UTC day, all workspaces: every analysis start answers 503 ai_paused. Default 1000; 0 pauses AI.
# While AI_DAILY_CALL_CAP is lower (its default is), that one is reached first.
AI_GLOBAL_DAILY_CAP=

# --- Email --------------------------------------------------------------------------------
# Production: required for real mail. `smtp` sends; empty or `log` only keeps messages in memory, so verification, invitation and reset links never reach anyone.
EMAIL_PROVIDER=
# Log adapter only: also append each message as a JSON line to this file. The e2e run sets it so tests can read the mail.
EMAIL_OUTBOX_FILE=
# Production with smtp: required. Sender address, for example "OW Slido <no-reply@example.com>".
EMAIL_FROM=
# Production with smtp: SMTP_HOST is required; SMTP_PORT defaults to 587 (465 uses TLS); SMTP_USER and SMTP_PASSWORD only if the server asks for a login.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Billing ------------------------------------------------------------------------------
# Production: required. `stripe` for real payments, `mock` for a demo. Unset in production means billing answers 503 and nobody can buy a plan. Outside production the default is `mock`. See docs/billing.md.
BILLING_PROVIDER=
# Production with the mock provider only: signs and verifies its events. Not used by stripe.
BILLING_WEBHOOK_SECRET=
# Production with stripe: all six are required (a missing one fails only the call that needs it, with 503).
# Secret key and the webhook endpoint's signing secret, then one price id per plan and interval.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=

# --- Accounts and operations --------------------------------------------------------------
# Production: required for two-factor login (without it nobody can enable 2FA and a workspace cannot require it).
# AES-256-GCM key for the stored TOTP secrets, 32 bytes as 64 hex characters or base64 (`openssl rand -hex 32`).
# Rotating it invalidates every stored secret and recovery code.
TWOFA_ENCRYPTION_KEY=
# Production: required to have an operator. Comma-separated emails (any case) that may open /ops. The account must also have a verified email.
# There is no screen to grant this; everyone else gets a 404 for /ops and /api/ops/*.
OPERATOR_EMAILS=
# Optional. Milliseconds to wait before retry 1, 2 and 3 of a failed background job (export, analysis). Default 1000,5000,20000.
JOB_RETRY_BACKOFF_MS=
# Optional. Milliseconds a quiz answer may arrive after the deadline and still count. Default 300.
QUIZ_GRACE_MS=
# Optional. Port of the server; Railway sets it. Default 3000.
PORT=
