DATABASE_URL=
TEST_DATABASE_URL=
SESSION_SECRET=
PARTICIPANT_TOKEN_SECRET=

# Set to false on a public deployment once the admins exist, so strangers cannot sign up.
ALLOW_SIGNUP=

# Hosts allowed to load `next dev` assets besides localhost (comma separated)
ALLOWED_DEV_ORIGINS=

# AI analysis for Shared Notes (platform owner's key; set only in .env.local)
AI_PROVIDER=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=
AI_EVENT_CALL_CAP=
AI_DAILY_CALL_CAP=
# Platform-wide AI calls per UTC day (all workspaces). When reached every analysis start answers 503 ai_paused. Default 1000; 0 pauses AI.
AI_GLOBAL_DAILY_CAP=

# Email: `log` (default) keeps messages in memory; `smtp` sends them.
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Billing: `mock` (default outside production) completes checkout through a local route; `stripe` uses Stripe.
# Production has no default, so set this explicitly. See docs/billing.md.
BILLING_PROVIDER=
# Mock provider only: signs and verifies its events.
BILLING_WEBHOOK_SECRET=
# Stripe (BILLING_PROVIDER=stripe): test-mode keys start with sk_test_ and whsec_; put them in .env.local only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=

# Two-factor login: AES-256-GCM key for the stored TOTP secrets, 32 bytes as 64 hex characters or base64
# (generate with `openssl rand -hex 32`). Without it 2FA cannot be enabled. Put it in .env.local only.
TWOFA_ENCRYPTION_KEY=
